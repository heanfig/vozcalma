# Copiar a .env o .env.local y rellenar (no commitear secretos).

# Clerk — https://dashboard.clerk.com
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
PUBLIC_CLERK_SIGN_IN_URL=/sign-in
PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Supabase — https://supabase.com/dashboard
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Servidor: JWT service_role (Legacy) o SUPABASE_SECRET_KEY (sb_secret_…)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Opcional: solo para `npm run db:migrate` (URI Postgres con contraseña; Dashboard → Database).
# DATABASE_URL=

# OpenRouter — https://openrouter.ai
OPENROUTER_API_KEY=
# Opcional; si vacío el código usa un valor por defecto razonable
OPENROUTER_MODEL=

# ElevenLabs — https://elevenlabs.io
ELEVENLABS_API_KEY=
# Opcional. Plan gratuito: no uses voces "premade" de biblioteca; creá una en Voice Design y pegá su voice_id.
ELEVENLABS_VOICE_ID=

# Audio Mixing (música de fondo en meditaciones)
# Directorio con tracks MP3 de fondo; default: <project>/assets/audio/backgrounds
# AUDIO_BG_DIR=
# Volumen de la música de fondo (0.0-1.0); default 0.15
# AUDIO_BG_VOLUME=0.15
# Fade in/out en segundos; default 3 / 5
# AUDIO_FADE_IN=3
# AUDIO_FADE_OUT=5
# Ruta al binario ffmpeg; default: ffmpeg (busca en PATH)
# FFMPEG_PATH=

# Endpoint admin (Bearer token)
ADMIN_API_SECRET=

# Opcional: URLs absolutas (play links). Si no se define, se usa https://vozcalma.app
PUBLIC_SITE_URL=https://vozcalma.app
