---
import PostHog from "../components/posthog.astro";
import "../styles/onboarding.css";
import BackgroundMusicWidget from "../components/BackgroundMusicWidget";

type Props = {
  title: string;
  description?: string;
  canonicalPath?: string;
  ogType?: "website" | "article";
};

const {
  title,
  description = "Meditaciones guiadas en español para ayudarte a vivir con más calma.",
  canonicalPath = "/",
  ogType = "website",
} = Astro.props;

const canonical = `https://vozcalma.app${canonicalPath}`;
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Anti-flash dark mode -->
    <script is:inline>
      (function(){var s=localStorage.getItem('vc-theme')||'system';var d=s==='dark'||(s==='system'&&window.matchMedia('(prefers-color-scheme:dark)').matches);if(d)document.documentElement.classList.add('dark')})();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <PostHog />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-surface font-body text-on-surface antialiased min-h-full">
    <!-- Header — mismo estilo que landing -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-surface/95 backdrop-blur-md border-b border-outline-variant/10">
      <div class="max-w-6xl mx-auto px-6 md:px-10 py-4 flex items-center justify-between">
        <a href="/" class="font-headline text-xl md:text-2xl font-semibold text-primary tracking-tight">
          VozCalma
        </a>
        <nav class="hidden md:flex items-center gap-8 text-sm font-label text-on-surface-variant">
          <a href="/blog" class="hover:text-primary transition-colors">Blog</a>
          <a href="/#activation" class="hover:text-primary transition-colors">Activación</a>
        </nav>
        <a
          href="/#activation"
          class="bg-primary text-on-primary px-5 py-2.5 rounded-full text-sm font-label font-semibold hover:opacity-90 transition-all shadow-md shadow-primary/10"
        >
          Empezar ritual
        </a>
      </div>
    </header>

    <!-- Main content -->
    <main class="pt-24 pb-16 px-6 md:px-10 min-h-[70vh]">
      <slot />
    </main>

    <!-- Background music widget -->
    <BackgroundMusicWidget client:idle />

    <!-- Footer — mismo estilo que landing -->
    <footer class="bg-surface-container-low px-6 md:px-10 py-12">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
        <p class="font-body text-xs text-on-surface-variant/70">
          © {new Date().getFullYear()} VozCalma. El Santuario Digital.
        </p>
        <nav class="flex items-center gap-6 text-xs font-label text-on-surface-variant/70">
          <a href="/politica-de-privacidad" class="hover:text-primary transition-colors">Privacidad</a>
          <a href="/terminos-del-servicio" class="hover:text-primary transition-colors">Términos</a>
          <a href="/aviso-legal" class="hover:text-primary transition-colors">Aviso Legal</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
