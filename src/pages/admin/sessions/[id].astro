---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminShell from "../../../components/admin/AdminShell";
import SessionDetail from "../../../components/admin/SessionDetail";

const currentPath = Astro.url.pathname;
const { id } = Astro.params;
---

<AdminLayout title={`Sesión ${id} — VozCalma Admin`}>
  <AdminShell client:load title="Detalle de sesión" currentPath={currentPath}>
    <SessionDetail client:load sessionId={id!} />
  </AdminShell>
</AdminLayout>
