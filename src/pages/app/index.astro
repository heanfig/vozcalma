---
import ChatApp from "../../components/ChatApp.tsx";
import { UserButton } from "@clerk/astro/components";
import "../../styles/app.css";
---

<!doctype html>
<html class="light" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chat — VozCalma</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif:wght@400;600;700&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-surface font-body text-on-surface">
    <header
      class="flex items-center justify-between border-b border-outline-variant/10 bg-surface-container-low/90 px-6 py-4 backdrop-blur-md"
    >
      <a href="/" class="font-headline text-xl font-bold text-primary">VozCalma</a>
      <UserButton />
    </header>
    <main class="mx-auto max-w-3xl px-4 py-8">
      <h1 class="font-headline text-on-surface mb-2 text-2xl font-semibold md:text-3xl">
        Tu sesión
      </h1>
      <p class="font-body text-on-surface-variant mb-6 text-sm">
        Respondé lo que necesites; cuando el guion esté listo, generá el audio.
      </p>
      <ChatApp client:load />
    </main>
  </body>
</html>
