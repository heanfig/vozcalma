---
import { blogPosts } from "../../lib/blog";

const { slug } = Astro.params;
const post = blogPosts.find((item) => item.slug === slug);

if (!post) {
  return Astro.redirect("/blog", 302);
}

const canonical = `https://vozcalma.app/blog/${post.slug}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{post.title} | VozCalma</title>
    <meta name="description" content={post.description} />
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={post.description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="VozCalma" />
    <link rel="canonical" href={canonical} />
  </head>
  <body style="font-family: Inter, system-ui, sans-serif; margin: 0; background: #faf9fb; color: #1b1c1e;">
    <main style="max-width: 760px; margin: 0 auto; padding: 40px 20px 80px;">
      <a href="/blog" style="color: #4f17ce; text-decoration: none; font-weight: 600;">← Volver al blog</a>
      <article style="margin-top: 18px; background: white; border-radius: 16px; padding: 24px; box-shadow: 0 2px 18px rgba(0,0,0,.05);">
        <p style="margin: 0; color: #777; font-size: .84rem;">{new Date(post.date).toLocaleDateString("es-CO")}</p>
        <h1 style="margin: 8px 0 16px; font-size: 2rem; line-height: 1.15;">{post.title}</h1>
        <p style="font-size: 1.08rem; color: #484455; margin-top: 0;">{post.description}</p>
        {post.content.map((paragraph) => (
          <p style="line-height: 1.75; color: #202124;">{paragraph}</p>
        ))}
      </article>
    </main>
  </body>
</html>
