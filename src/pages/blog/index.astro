---
import PublicSiteLayout from "../../layouts/PublicSiteLayout.astro";
import { blogPosts } from "../../lib/blog";

const posts = [...blogPosts].sort((a, b) => (a.date < b.date ? 1 : -1));
const featured = posts[0];
const rest = posts.slice(1);
---

<PublicSiteLayout
  title="Blog de bienestar | VozCalma"
  description="Artículos de bienestar, respiración y meditación guiada para vivir con más calma."
  canonicalPath="/blog"
>
  <style>
    .blog-wrap{max-width:1160px;margin:0 auto;padding:0 24px}
    .blog-hero{position:relative;overflow:hidden;border-bottom:1px solid #e3e2e4;background:#f5f3f5;padding:64px 0}
    .blog-hero-glow{position:absolute;right:-80px;top:-20px;width:300px;height:300px;border-radius:999px;background:rgba(79,23,206,.12);filter:blur(46px)}
    .blog-eyebrow{font-size:11px;font-weight:700;letter-spacing:.2em;text-transform:uppercase;color:#4f17ce}
    .blog-title{margin:12px 0 0;max-width:820px;font-family:"Noto Serif",serif;font-size:48px;line-height:1.12}
    .blog-sub{margin:16px 0 0;max-width:760px;color:#484455;font-size:19px;line-height:1.6}
    .blog-grid{max-width:1160px;margin:0 auto;padding:48px 24px;display:grid;gap:24px;grid-template-columns:1.2fr .8fr}
    .blog-featured{border:1px solid #e3e2e4;background:#fff;border-radius:28px;padding:30px;box-shadow:0 8px 34px rgba(0,0,0,.04)}
    .blog-featured h2{margin:10px 0 0;font-family:"Noto Serif",serif;font-size:42px;line-height:1.1}
    .blog-featured p{color:#484455;line-height:1.7}
    .blog-chip{font-size:11px;color:#4f17ce;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
    .blog-date{font-size:12px;color:#7a7a85}
    .blog-btn{display:inline-flex;margin-top:18px;background:#4f17ce;color:#fff;text-decoration:none;padding:10px 18px;border-radius:999px;font-weight:700;font-size:14px}
    .blog-side{border:1px solid #e3e2e4;background:#f5f3f5;border-radius:28px;padding:24px}
    .blog-side h3{margin:0;font-family:"Noto Serif",serif;font-size:26px}
    .blog-item{display:block;background:#fff;border-radius:18px;padding:14px;text-decoration:none;margin-top:12px;color:#1b1c1e;box-shadow:0 2px 12px rgba(0,0,0,.03)}
    .blog-item-date{font-size:11px;color:#7a7a85;text-transform:uppercase;letter-spacing:.08em}
    .blog-item-title{margin-top:5px;font-size:15px;font-weight:700;line-height:1.35}
    @media (max-width: 960px){
      .blog-title{font-size:38px}
      .blog-grid{grid-template-columns:1fr}
    }
  </style>

  <section class="blog-hero">
    <div class="blog-hero-glow"></div>
    <div class="blog-wrap">
      <p class="blog-eyebrow">Blog editorial</p>
      <h1 class="blog-title">
        Ideas simples para respirar mejor, dormir con más calma y bajar el estrés diario
      </h1>
      <p class="blog-sub">
        Lecturas breves y accionables para acompañarte en tu práctica personal de bienestar.
      </p>
    </div>
  </section>

  <section class="blog-grid">
    {featured && (
      <article class="blog-featured">
        <p class="blog-chip">Artículo destacado</p>
        <p class="blog-date">{new Date(featured.date).toLocaleDateString("es-CO")}</p>
        <h2>
          <a style="color:inherit;text-decoration:none" href={`/blog/${featured.slug}`}>{featured.title}</a>
        </h2>
        <p>{featured.description}</p>
        <a
          href={`/blog/${featured.slug}`}
          class="blog-btn"
        >
          Leer artículo
        </a>
      </article>
    )}

    <aside class="blog-side">
      <h3>Más leídos</h3>
      <div>
        {rest.map((post) => (
          <a href={`/blog/${post.slug}`} class="blog-item">
            <p class="blog-item-date">
              {new Date(post.date).toLocaleDateString("es-CO")}
            </p>
            <p class="blog-item-title">{post.title}</p>
          </a>
        ))}
      </div>
    </aside>
  </section>
</PublicSiteLayout>
