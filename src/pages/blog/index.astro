---
import { blogPosts } from "../../lib/blog";

const posts = [...blogPosts].sort((a, b) => (a.date < b.date ? 1 : -1));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog de bienestar | VozCalma</title>
    <meta
      name="description"
      content="Artículos de bienestar, respiración y meditación guiada para vivir con más calma."
    />
    <link rel="canonical" href="https://vozcalma.app/blog" />
  </head>
  <body style="font-family: Inter, system-ui, sans-serif; margin: 0; background: #faf9fb; color: #1b1c1e;">
    <main style="max-width: 860px; margin: 0 auto; padding: 40px 20px 80px;">
      <a href="/" style="color: #4f17ce; text-decoration: none; font-weight: 600;">← Volver al inicio</a>
      <h1 style="font-size: 2rem; margin: 16px 0 12px;">Blog VozCalma</h1>
      <p style="color: #555; margin: 0 0 28px;">
        Consejos prácticos de respiración, descanso y meditación para tu bienestar diario.
      </p>
      <div style="display: grid; gap: 14px;">
        {posts.map((post) => (
          <article style="background: white; border-radius: 14px; padding: 18px 20px; box-shadow: 0 2px 18px rgba(0,0,0,.05);">
            <p style="margin: 0; font-size: .82rem; color: #777;">{new Date(post.date).toLocaleDateString("es-CO")}</p>
            <h2 style="margin: 6px 0 10px; font-size: 1.28rem;">
              <a href={`/blog/${post.slug}`} style="color: #1b1c1e; text-decoration: none;">{post.title}</a>
            </h2>
            <p style="margin: 0; color: #555;">{post.description}</p>
          </article>
        ))}
      </div>
    </main>
  </body>
</html>
