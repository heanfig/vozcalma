    <meta
      property="og:description"
      content="Cuéntanos qué necesitas y te entregamos una meditación con tu nombre y tu situación, en menos de 3 minutos."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vozcalma.app/" />
    <link rel="canonical" href="https://vozcalma.app/" />

