  <body class="bg-surface font-body text-on-surface antialiased">
    <!-- ================= HEADER ================= -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-surface/80 backdrop-blur-md border-b border-outline-variant/10">
      <div class="max-w-6xl mx-auto px-6 md:px-10 py-4 flex items-center justify-between">
        <a href="#" class="font-headline text-xl md:text-2xl font-semibold text-primary tracking-tight">
          VozCalma
        </a>
        <nav class="hidden md:flex items-center gap-7 text-sm font-label text-on-surface-variant">
          <a href="#como-funciona" class="hover:text-primary transition-colors">Cómo funciona</a>
          <a href="#precios" class="hover:text-primary transition-colors">Precios</a>
          <a href="#faq" class="hover:text-primary transition-colors">Preguntas</a>
          <a href="#articulos" class="hover:text-primary transition-colors">Artículos</a>
        </nav>
        <div class="flex items-center gap-2">
          <button
            id="theme-toggle"
            type="button"
            aria-label="Cambiar modo de color"
            class="w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant hover:text-primary hover:bg-surface-container-high transition-colors"
          >
            <span class="material-symbols-outlined text-lg" id="theme-icon">dark_mode</span>
          </button>
          <a
            href="/onboarding"
            data-cta="header"
            class="bg-primary text-on-primary px-5 py-2.5 rounded-full text-sm font-label font-semibold hover:opacity-90 transition-all shadow-md shadow-primary/10"
          >
            Crear mi meditación
          </a>
        </div>
      </div>
    </header>

    <!-- ================= HERO ================= -->
    <section class="relative pt-28 pb-16 md:pt-40 md:pb-24 px-6 md:px-10 overflow-hidden">
      <div class="absolute inset-0 -z-10 pointer-events-none">
        <div class="absolute top-0 right-0 w-[60%] h-[70%] bg-gradient-to-bl from-primary-fixed/40 via-primary-fixed/10 to-transparent blur-3xl rounded-full"></div>
        <div class="absolute bottom-0 left-0 w-[50%] h-[60%] bg-gradient-to-tr from-tertiary-fixed/30 to-transparent blur-3xl rounded-full"></div>
      </div>

      <div class="max-w-4xl mx-auto text-center space-y-7">
        <p class="font-label text-xs md:text-sm uppercase tracking-[0.3em] text-tertiary/80">
          Meditaciones personalizadas con IA
        </p>
        <h1 class="font-headline text-[2.25rem] sm:text-5xl md:text-6xl lg:text-7xl leading-[1.05] tracking-tight text-on-surface">
          Una meditación creada
          <span class="block italic text-primary mt-2">solo para ti.</span>
        </h1>
        <p class="font-body text-base md:text-xl text-on-surface-variant max-w-2xl mx-auto leading-relaxed">
          Cuéntanos qué estás viviendo hoy y te entregamos una sesión guiada con
          tu nombre, tu situación y el tono exacto que necesitas. En menos de 3 minutos.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-3">
          <a
            href="/onboarding"
            data-cta="hero-primary"
            class="inline-flex items-center justify-center gap-3 bg-primary text-on-primary px-8 py-4 rounded-full font-label font-semibold text-base md:text-lg hover:opacity-90 transition-all shadow-xl shadow-primary/15 w-full sm:w-auto"
          >
            <span>Crear mi meditación</span>
            <span class="material-symbols-outlined text-xl">arrow_forward</span>
          </a>
          <a
            href="#demo"
            data-cta="hero-secondary"
            class="inline-flex items-center justify-center gap-2 px-6 py-4 rounded-full font-label font-semibold text-base text-on-surface-variant hover:text-primary transition-colors w-full sm:w-auto"
          >
            <span class="material-symbols-outlined text-xl">graphic_eq</span>
            <span>Escuchar una muestra</span>
          </a>
        </div>
        <p class="font-body text-xs md:text-sm text-on-surface-variant/60 pt-2">
          Sin suscripción · Pagas solo cuando quieras una nueva
        </p>
      </div>
    </section>

    <!-- ================= DEMO (SAMPLE PLAYER) ================= -->
    <section id="demo" class="px-6 md:px-10 py-16 md:py-20 bg-surface scroll-mt-20">
      <div class="max-w-4xl mx-auto text-center mb-10">
        <p class="font-label text-xs md:text-sm uppercase tracking-[0.3em] text-tertiary/80">
          Escucha primero
        </p>
        <h2 class="font-headline text-3xl md:text-5xl text-on-surface leading-tight tracking-tight mt-3">
          Esto es <span class="italic text-primary">cómo suena</span>.
        </h2>
        <p class="font-body text-base md:text-lg text-on-surface-variant max-w-xl mx-auto mt-4 leading-relaxed">
          Reproduce una muestra real de cualquier categoría. Sin pagar, sin registrarte.
        </p>
      </div>
      <SamplePlayer client:load />
    </section>

    <!-- ================= CÓMO FUNCIONA ================= -->
    <section id="como-funciona" class="px-6 md:px-10 py-20 md:py-28 bg-surface-container-low scroll-mt-20">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-14 space-y-4">
          <p class="font-label text-xs md:text-sm uppercase tracking-[0.3em] text-tertiary/80">
            Cómo funciona
          </p>
          <h2 class="font-headline text-3xl md:text-5xl text-on-surface leading-tight tracking-tight">
            Tres pasos. <span class="italic text-primary">Tu meditación lista.</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
          <div class="bg-surface rounded-[2rem] p-8 md:p-9 space-y-4 relative">
            <div class="absolute top-6 right-6 font-headline text-5xl italic text-primary/15">1</div>
            <div class="w-12 h-12 rounded-full bg-primary-fixed flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-2xl">edit_note</span>
            </div>
            <h3 class="font-headline text-xl md:text-2xl text-on-surface">
              Cuéntanos qué necesitas
            </h3>
            <p class="font-body text-sm md:text-base text-on-surface-variant leading-relaxed">
              Responde unas pocas preguntas sobre lo que estás viviendo hoy. 2 minutos.
              No hay respuestas correctas.
            </p>
          </div>

          <div class="bg-surface rounded-[2rem] p-8 md:p-9 space-y-4 relative">
            <div class="absolute top-6 right-6 font-headline text-5xl italic text-primary/15">2</div>
            <div class="w-12 h-12 rounded-full bg-tertiary-fixed flex items-center justify-center text-tertiary">
              <span class="material-symbols-outlined text-2xl">auto_awesome</span>
            </div>
            <h3 class="font-headline text-xl md:text-2xl text-on-surface">
              Creamos tu sesión
            </h3>
            <p class="font-body text-sm md:text-base text-on-surface-variant leading-relaxed">
              Generamos un guion único con tu nombre, tu intención y tu tono. Lo
              convertimos en audio guiado con voz cálida en español.
            </p>
          </div>

          <div class="bg-surface rounded-[2rem] p-8 md:p-9 space-y-4 relative">
            <div class="absolute top-6 right-6 font-headline text-5xl italic text-primary/15">3</div>
            <div class="w-12 h-12 rounded-full bg-primary-fixed flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-2xl">headphones</span>
            </div>
            <h3 class="font-headline text-xl md:text-2xl text-on-surface">
              Escucha cuando quieras
            </h3>
            <p class="font-body text-sm md:text-base text-on-surface-variant leading-relaxed">
              Recibe tu audio en menos de 3 minutos. Reprodúcelo online o descárgalo
              para escucharlo sin conexión.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= PRECIOS ================= -->
    <section id="precios" class="px-6 md:px-10 py-20 md:py-28 bg-surface scroll-mt-20">
      <div class="max-w-5xl mx-auto">
        <div class="text-center mb-12 space-y-4">
          <p class="font-label text-xs md:text-sm uppercase tracking-[0.3em] text-tertiary/80">
            Precios
          </p>
          <h2 class="font-headline text-3xl md:text-5xl text-on-surface leading-tight tracking-tight">
            Elige el camino que <span class="italic text-primary">necesitas hoy</span>.
          </h2>
          <p class="font-body text-base md:text-lg text-on-surface-variant max-w-xl mx-auto leading-relaxed">
            Pagas por sesión. Sin suscripción, sin renovaciones automáticas.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 items-stretch">
          <!-- Quick -->
          <div class="bg-surface-container-low rounded-[2rem] p-8 md:p-10 border border-outline-variant/20 hover:shadow-xl hover:-translate-y-1 transition-all duration-500 flex flex-col">
            <div class="flex items-center gap-3 min-h-[3.5rem]">
              <div class="w-12 h-12 rounded-full bg-tertiary-fixed flex items-center justify-center text-tertiary flex-shrink-0">
                <span class="material-symbols-outlined text-2xl">spa</span>
              </div>
              <h3 class="font-headline text-2xl md:text-3xl text-on-surface italic">
                Alivio Rápido
              </h3>
            </div>
            <p class="font-body text-base text-on-surface-variant leading-relaxed mt-5 flex-1">
              Una sesión corta para soltar lo que pesa hoy. Calma mental, descanso,
              gestión emocional o presencia. 3 a 4 minutos.
            </p>
            <div class="pt-6">
              <p class="font-headline text-4xl md:text-5xl text-on-surface">
                {quickPrice}
              </p>
              <p class="font-body text-xs text-on-surface-variant/70 mt-1">
                Pago único · Sin renovación
              </p>
            </div>
            <a
              href="/onboarding/alivio-rapido"
              data-cta="pricing-quick"
              class="inline-flex items-center justify-center gap-2 w-full bg-primary text-on-primary px-6 py-3.5 rounded-full font-label font-semibold text-sm md:text-base hover:opacity-90 transition-all shadow-md shadow-primary/15 mt-5"
            >
              Crear meditación rápida
              <span class="material-symbols-outlined text-lg">arrow_forward</span>
            </a>
          </div>

          <!-- Deep -->
          <div class="bg-surface-container-low rounded-[2rem] p-8 md:p-10 border-2 border-primary/30 hover:shadow-xl hover:-translate-y-1 transition-all duration-500 relative flex flex-col">
            <span class="absolute -top-3 left-8 bg-primary text-on-primary text-[10px] font-label font-semibold uppercase tracking-widest px-3 py-1 rounded-full shadow-md">
              Recomendado
            </span>
            <div class="flex items-center gap-3 min-h-[3.5rem]">
              <div class="w-12 h-12 rounded-full bg-primary-fixed flex items-center justify-center text-primary flex-shrink-0">
                <span class="material-symbols-outlined text-2xl">psychology</span>
              </div>
              <h3 class="font-headline text-2xl md:text-3xl text-on-surface italic">
                Reprogramación Profunda
              </h3>
            </div>
            <p class="font-body text-base text-on-surface-variant leading-relaxed mt-5 flex-1">
              Una sesión más larga para trabajar patrones, identidad y reprogramación
              subconsciente. 6 a 8 minutos. Cuando lo que buscas es transformación, no solo alivio.
            </p>
            <div class="pt-6">
              <p class="font-headline text-4xl md:text-5xl text-on-surface">
                {deepPrice}
              </p>
              <p class="font-body text-xs text-on-surface-variant/70 mt-1">
                Pago único · Sin renovación
              </p>
            </div>
            <a
              href="/onboarding/reprogramacion-profunda"
              data-cta="pricing-deep"
              class="inline-flex items-center justify-center gap-2 w-full bg-primary text-on-primary px-6 py-3.5 rounded-full font-label font-semibold text-sm md:text-base hover:opacity-90 transition-all shadow-md shadow-primary/15 mt-5"
            >
              Crear meditación profunda
              <span class="material-symbols-outlined text-lg">arrow_forward</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ================= MANIFESTO (alma poética conservada) ================= -->
    <section class="relative px-6 md:px-10 py-20 md:py-28 bg-surface-container-low">
      <div class="max-w-4xl mx-auto space-y-10">
        <div class="text-center space-y-4">
          <p class="font-label text-xs md:text-sm uppercase tracking-[0.3em] text-tertiary/80">
            El Manifiesto
          </p>
          <h2 class="font-headline text-3xl md:text-5xl lg:text-6xl text-on-surface leading-tight tracking-tight">
            Esto no es para <span class="italic text-primary">cualquiera</span>.
          </h2>
        </div>

        <div class="max-w-2xl mx-auto text-center space-y-6">
          <p class="font-body text-lg md:text-xl text-on-surface-variant leading-relaxed">
            VozCalma fue diseñada para quienes buscan algo más que una biblioteca
            de meditaciones genéricas. Para quienes quieren una sesión hecha a la medida
            de su momento — no la de alguien más.
          </p>
          <p class="font-body text-lg md:text-xl text-on-surface-variant leading-relaxed">
            Tu nombre, tu historia, tu situación específica se convierten en el material
            desde donde nace cada audio. Una meditación íntima, hecha para ti, hoy.
          </p>
        </div>
      </div>
    </section>

    <!-- ================= FAQ ================= -->
    <section id="faq" class="px-6 md:px-10 py-20 md:py-28 bg-surface scroll-mt-20">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12 space-y-4">
          <p class="font-label text-xs md:text-sm uppercase tracking-[0.3em] text-tertiary/80">
            Preguntas frecuentes
          </p>
          <h2 class="font-headline text-3xl md:text-5xl text-on-surface leading-tight tracking-tight">
            Lo que casi todos <span class="italic text-primary">se preguntan</span>.
          </h2>
        </div>
        <FAQ client:load />
      </div>
    </section>

    <!-- ================= ARTÍCULOS (BLOG) ================= -->
    <section id="articulos" class="px-6 md:px-10 py-20 md:py-28 bg-surface-container-low">
      <div class="max-w-6xl mx-auto">
        <div class="text-center space-y-4 mb-14">
          <p class="font-label text-xs md:text-sm uppercase tracking-[0.3em] text-tertiary/80">
            Artículos
          </p>
          <h2 class="font-headline text-3xl md:text-5xl text-on-surface leading-tight tracking-tight">
            Lee, respira, <span class="italic text-primary">transforma</span>.
          </h2>
          <p class="font-body text-base md:text-lg text-on-surface-variant max-w-xl mx-auto leading-relaxed">
            Herramientas y reflexiones para acompañarte en tu camino interior.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
          {latestPosts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              class="group bg-surface rounded-[2rem] p-8 md:p-9 flex flex-col gap-4 hover:shadow-xl hover:-translate-y-1 transition-all duration-500"
            >
              <time class="text-xs font-label uppercase tracking-widest text-on-surface-variant/60">
                {formatDate(post.date)}
              </time>
              <h3 class="font-headline text-xl md:text-2xl text-on-surface italic leading-tight">
                {post.title}
              </h3>
              <p class="font-body text-sm text-on-surface-variant leading-relaxed line-clamp-3 flex-1">
                {post.description}
              </p>
              <span class="inline-flex items-center gap-2 text-sm font-label font-semibold text-primary group-hover:gap-3 transition-all">
                Leer artículo
                <span class="material-symbols-outlined text-base">arrow_forward</span>
              </span>
            </a>
          ))}
        </div>

        <div class="text-center mt-12">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 font-label text-sm font-semibold text-on-surface-variant hover:text-primary transition-colors"
          >
            Ver todos los artículos
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= CIERRE / CTA FINAL ================= -->
    <section class="relative px-6 md:px-10 py-24 md:py-32 bg-gradient-to-b from-surface via-surface to-primary-fixed/20 overflow-hidden">
      <div class="absolute inset-0 -z-10 pointer-events-none">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[70%] h-[80%] bg-primary/5 blur-3xl rounded-full"></div>
      </div>
      <div class="max-w-2xl mx-auto text-center space-y-7">
        <h2 class="font-headline text-3xl md:text-5xl lg:text-6xl text-on-surface leading-tight tracking-tight">
          Tu próxima meditación <span class="italic text-primary">empieza con una pregunta</span>.
        </h2>
        <p class="font-body text-base md:text-lg text-on-surface-variant max-w-lg mx-auto leading-relaxed">
          ¿Qué estás viviendo hoy?
        </p>
        <div class="pt-2">
          <a
            href="/onboarding"
            data-cta="footer-final"
            class="inline-flex items-center gap-3 bg-primary text-on-primary px-8 py-4 rounded-full font-label font-semibold text-base md:text-lg hover:opacity-90 transition-all shadow-xl shadow-primary/15"
          >
            <span>Crear mi meditación</span>
            <span class="material-symbols-outlined text-xl">arrow_forward</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ================= FOOTER ================= -->
    <footer class="bg-surface-container-low px-6 md:px-10 py-10 border-t border-outline-variant/10">
      <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="text-center md:text-left">
          <p class="font-body text-xs text-on-surface-variant/70">
            © {new Date().getFullYear()} VozCalma. Hecho con cuidado en Colombia.
          </p>
        </div>
        <nav class="flex items-center gap-6 text-xs font-label text-on-surface-variant/70">
          <a href="/politica-de-privacidad" class="hover:text-primary transition-colors">Privacidad</a>
          <a href="/terminos-del-servicio" class="hover:text-primary transition-colors">Términos</a>
          <a href="/aviso-legal" class="hover:text-primary transition-colors">Aviso Legal</a>
        </nav>
      </div>
    </footer>

    <BackgroundMusicWidget client:idle />

    <!-- Interactive wiring -->
    <script is:inline>
      (function () {
        // Theme toggle (dark mode)
        var themeBtn = document.getElementById("theme-toggle");
        var themeIcon = document.getElementById("theme-icon");
        function updateThemeIcon() {
          var isDark = document.documentElement.classList.contains("dark");
          if (themeIcon) themeIcon.textContent = isDark ? "light_mode" : "dark_mode";
        }
        updateThemeIcon();
        if (themeBtn) {
          themeBtn.addEventListener("click", function () {
            var isDark = document.documentElement.classList.contains("dark");
            var next = isDark ? "light" : "dark";
            document.documentElement.classList.toggle("dark", next === "dark");
            localStorage.setItem("vc-theme", next);
            updateThemeIcon();
            if (window.posthog && typeof window.posthog.capture === "function") {
              window.posthog.capture("landing_theme_toggled", { from: isDark ? "dark" : "light", to: next });
            }
          });
        }

        // Track CTA clicks (capture intent)
        document.querySelectorAll("[data-cta]").forEach(function (el) {
          el.addEventListener("click", function () {
            var label = el.getAttribute("data-cta");
            if (window.posthog && typeof window.posthog.capture === "function") {
              window.posthog.capture("hero_cta_clicked", { cta: label });
            }
          });
        });

        // Capturar UTM + coupon → preservar en links de onboarding
        try {
          var qp = new URLSearchParams(window.location.search);
          var utm = {
            utm_source: qp.get("utm_source"),
            utm_medium: qp.get("utm_medium"),
            utm_campaign: qp.get("utm_campaign"),
            coupon: qp.get("coupon"),
          };
          var qs = new URLSearchParams();
          if (utm.utm_source) qs.set("utm_source", utm.utm_source);
          if (utm.utm_medium) qs.set("utm_medium", utm.utm_medium);
          if (utm.utm_campaign) qs.set("utm_campaign", utm.utm_campaign);
          if (utm.coupon) qs.set("coupon", utm.coupon);
          var qsStr = qs.toString();
          if (qsStr) {
            document.querySelectorAll('a[href^="/onboarding"]').forEach(function (a) {
              var href = a.getAttribute("href");
              if (!href) return;
              var sep = href.indexOf("?") >= 0 ? "&" : "?";
              a.setAttribute("href", href + sep + qsStr);
            });
          }
        } catch (e) {}
      })();
    </script>
  </body>
</html>
