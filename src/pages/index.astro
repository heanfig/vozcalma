---
// Landing Page — VozCalma
// Tono concreto y diferenciador en hero/pricing/FAQ; alma poética se conserva
// en manifiesto, blog y sección "El Nacimiento". Pricing transparente +
// muestra audible + cómo funciona + FAQ + garantía.
import "../styles/onboarding.css";
import { blogPosts } from "../lib/blog";
import BackgroundMusicWidget from "../components/BackgroundMusicWidget";
import SamplePlayer from "../components/landing/SamplePlayer";
import FAQ from "../components/landing/FAQ";
import { PRICE_QUICK_COP_CENTS, PRICE_DEEP_COP_CENTS } from "../lib/constants";
import { formatCOP } from "../lib/format";

const latestPosts = [...blogPosts]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

const quickPrice = formatCOP(PRICE_QUICK_COP_CENTS);
const deepPrice = formatCOP(PRICE_DEEP_COP_CENTS);

const formatDate = (iso: string) => {
  try {
    return new Date(iso).toLocaleDateString("es-CO", {
      day: "numeric",
      month: "long",
      year: "numeric",
    });
  } catch {
    return iso;
  }
};
---

