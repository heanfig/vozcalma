---
// Landing Page Persuasiva — VozCalma
// Diseño basado en Stitch project 15344559829188899043 screen f29b71c9d6...
// Estática (Astro), sin React hydration para primera impresión rápida.
import "../styles/onboarding.css";
import { blogPosts } from "../lib/blog";
import BackgroundMusicWidget from "../components/BackgroundMusicWidget";

const latestPosts = [...blogPosts]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

const formatDate = (iso: string) => {
  try {
    return new Date(iso).toLocaleDateString("es-CO", {
      day: "numeric",
      month: "long",
      year: "numeric",
    });
  } catch {
    return iso;
  }
};
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Anti-flash: aplica dark mode ANTES del primer paint -->
    <script is:inline>
      (function(){var s=localStorage.getItem('vc-theme')||'system';var d=s==='dark'||(s==='system'&&window.matchMedia('(prefers-color-scheme:dark)').matches);if(d)document.documentElement.classList.add('dark')})();
    </script>
    <title>VozCalma — El Santuario Digital</title>
    <meta
      name="description"
      content="No todos están listos para cambiar su mente. Meditaciones personalizadas que transforman tu estado emocional en minutos. Tu ritual de activación comienza aquí."
    />
    <meta property="og:title" content="VozCalma — El Santuario Digital" />
    <meta
      property="og:description"
      content="No todos están listos para cambiar su mente… pero si estás aquí, algo en ti ya comenzó."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vozcalma.app/" />
    <link rel="canonical" href="https://vozcalma.app/" />

    <!-- PostHog (analytics) -->
