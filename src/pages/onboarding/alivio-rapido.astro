---
import OnboardingFlow from "../../components/onboarding/OnboardingFlow";
import "../../styles/onboarding.css";
import { readSession } from "../../lib/session-cookie";
import { signCsrfToken } from "../../lib/csrf";

const session = readSession(Astro.cookies);
const queryName = Astro.url.searchParams.get("name")?.trim() || undefined;
const initialName = session?.name || queryName;
const sessionId = session?.sessionId || "anonymous";
const csrfToken = signCsrfToken(sessionId);
const existingPaidSessionId = Astro.url.searchParams.get("session") || undefined;
---

<!doctype html>
<html lang="es" class="h-full w-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Alivio Rápido — VozCalma</title>
    <meta
      name="description"
      content="Sesión de alivio rápido personalizada con IA para calmar tu mente en minutos."
    />
    <meta name="csrf-token" content={csrfToken} />
    <meta name="session-id" content={sessionId} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="m-0 p-0 w-full min-h-full font-body text-on-surface overflow-y-auto bg-soft-gradient">
    <div id="app" class="w-full min-h-screen">
      <OnboardingFlow type="quick" sessionId={existingPaidSessionId} initialName={initialName} client:load />
    </div>
  </body>
</html>
