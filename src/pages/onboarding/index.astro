---
import OnboardingFlow from "../../components/onboarding/OnboardingFlow";
import BackgroundMusicWidget from "../../components/BackgroundMusicWidget";
import "../../styles/onboarding.css";
import { readSession } from "../../lib/session-cookie";
import { signCsrfToken } from "../../lib/csrf";

// Preferir cookie firmada. Fallback al query param para compatibilidad/links directos.
const session = readSession(Astro.cookies);
const queryName = Astro.url.searchParams.get("name")?.trim() || undefined;
const initialName = session?.name || queryName;

// CSRF token: si hay session cookie, lo firmamos con su sessionId.
// Si solo hay query param (fallback), firmamos un sessionId ad-hoc (el endpoint
// aún requerirá una cookie válida — el query fallback NO autoriza a generar).
const sessionId = session?.sessionId || "anonymous";
const csrfToken = signCsrfToken(sessionId);

const existingPaidSessionId = Astro.url.searchParams.get("session") || undefined;
const initialCouponCode = Astro.url.searchParams.get("coupon")?.trim() || undefined;
---

<!doctype html>
<html lang="es" class="h-full w-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>(function(){var s=localStorage.getItem('vc-theme')||'system';var d=s==='dark'||(s==='system'&&window.matchMedia('(prefers-color-scheme:dark)').matches);if(d)document.documentElement.classList.add('dark')})();</script>
    <title>Onboarding — VozCalma</title>
    <meta
      name="description"
      content="Sesión de meditación personalizada con IA. Elige tu camino hacia la paz."
    />
    <meta name="csrf-token" content={csrfToken} />
    <meta name="session-id" content={sessionId} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="m-0 p-0 w-full min-h-full font-body text-on-surface overflow-y-auto bg-soft-gradient">
    <!-- Dark mode toggle (flotante, no hay header en onboarding) -->
    <button
      id="theme-toggle-onb"
      type="button"
      aria-label="Cambiar modo de color"
      class="fixed top-3 right-3 z-50 w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant/50 hover:text-primary hover:bg-surface-container-high/50 transition-colors"
    >
      <span class="material-symbols-outlined text-lg" id="theme-icon-onb">dark_mode</span>
    </button>
    <script is:inline>
      (function(){
        var btn=document.getElementById("theme-toggle-onb"),icon=document.getElementById("theme-icon-onb");
        function u(){if(icon)icon.textContent=document.documentElement.classList.contains("dark")?"light_mode":"dark_mode"}
        u();
        if(btn)btn.addEventListener("click",function(){
          var d=!document.documentElement.classList.contains("dark");
          document.documentElement.classList.toggle("dark",d);
          localStorage.setItem("vc-theme",d?"dark":"light");u();
        });
      })();
    </script>
    <!-- Background music widget -->
    <BackgroundMusicWidget client:idle />
    <div id="app" class="w-full min-h-screen">
      <OnboardingFlow sessionId={existingPaidSessionId} initialName={initialName} initialCouponCode={initialCouponCode} client:load />
    </div>
  </body>
</html>
