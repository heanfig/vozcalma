---
import OnboardingFlow from "../../components/onboarding/OnboardingFlow";
import BackgroundMusicWidget from "../../components/BackgroundMusicWidget";
import "../../styles/onboarding.css";
import { ensureFreshSession } from "../../lib/ensure-fresh-session";
import { signCsrfToken } from "../../lib/csrf";
import { getSupabaseAdmin } from "../../lib/supabase-server";

const rawSessionParam = Astro.url.searchParams.get("session") || undefined;
const session = await ensureFreshSession(Astro.cookies, rawSessionParam);
const queryName = Astro.url.searchParams.get("name")?.trim() || undefined;
const initialName = session?.name || queryName;
const sessionId = session?.sessionId || "anonymous";
const csrfToken = signCsrfToken(sessionId);
const initialCouponCode = Astro.url.searchParams.get("coupon")?.trim() || undefined;

// Validar ?session=<sid>:
//   - sin pagar o ya consumida (audio_url presente) → ignorar (forzar nuevo pago)
//   - type "quick" → redirigir al flujo correcto (type lock)
let existingPaidSessionId: string | undefined;
if (rawSessionParam) {
  const supabase = getSupabaseAdmin();
  const { data: row } = await supabase
    .from("onboarding_sessions")
    .select("type, is_paid, audio_url")
    .eq("id", rawSessionParam)
    .maybeSingle();
  const isUsable = !!row && !!row.is_paid && !row.audio_url;
  if (isUsable) {
    existingPaidSessionId = rawSessionParam;
    if (row.type === "quick") {
      const qs = new URLSearchParams();
      qs.set("session", existingPaidSessionId);
      if (initialCouponCode) qs.set("coupon", initialCouponCode);
      if (queryName) qs.set("name", queryName);
      return Astro.redirect(`/onboarding/alivio-rapido?${qs.toString()}`, 302);
    }
  }
}
---

<!doctype html>
<html lang="es" class="h-full w-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>(function(){var s=localStorage.getItem('vc-theme')||'system';var d=s==='dark'||(s==='system'&&window.matchMedia('(prefers-color-scheme:dark)').matches);if(d)document.documentElement.classList.add('dark')})();</script>
    <title>Reprogramación Profunda — VozCalma</title>
    <meta
      name="description"
      content="Sesión de reprogramación profunda personalizada con IA para transformar tu estado emocional."
    />
    <meta name="csrf-token" content={csrfToken} />
    <meta name="session-id" content={sessionId} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="m-0 p-0 w-full min-h-full font-body text-on-surface overflow-y-auto bg-soft-gradient">
    <button id="theme-toggle-onb" type="button" aria-label="Cambiar modo de color" class="fixed top-3 right-3 z-50 w-9 h-9 rounded-full flex items-center justify-center text-on-surface-variant/50 hover:text-primary hover:bg-surface-container-high/50 transition-colors">
      <span class="material-symbols-outlined text-lg" id="theme-icon-onb">dark_mode</span>
    </button>
    <script is:inline>(function(){var b=document.getElementById("theme-toggle-onb"),i=document.getElementById("theme-icon-onb");function u(){if(i)i.textContent=document.documentElement.classList.contains("dark")?"light_mode":"dark_mode"}u();if(b)b.addEventListener("click",function(){var d=!document.documentElement.classList.contains("dark");document.documentElement.classList.toggle("dark",d);localStorage.setItem("vc-theme",d?"dark":"light");u()})})();</script>
    <BackgroundMusicWidget client:idle />
    <div id="app" class="w-full min-h-screen">
      <OnboardingFlow type="deep" sessionId={existingPaidSessionId} initialName={initialName} initialCouponCode={initialCouponCode} client:load />
    </div>
  </body>
</html>
