---
import PostHog from "../../components/posthog.astro";
import OnboardingPlayer from "../../components/onboarding/OnboardingPlayer";
import BackgroundMusicWidget from "../../components/BackgroundMusicWidget";
import "../../styles/onboarding.css";
import { getSupabaseAdmin } from "../../lib/supabase-server";

const { token } = Astro.params;

if (!token) {
  return Astro.redirect("/");
}

const supabase = getSupabaseAdmin();

const { data, error } = await supabase
  .from("play_links")
  .select("audio_url, expires_at, session_id, onboarding_sessions(intake_json, type)")
  .eq("token", token)
  .maybeSingle();

if (error || !data) {
  return new Response("Enlace no encontrado", {
    status: 404,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  });
}

if (new Date(data.expires_at) < new Date()) {
  return new Response("Este enlace expiró", {
    status: 410,
    headers: { "Content-Type": "text/plain; charset=utf-8" },
  });
}

const audioUrl = data.audio_url;
const session = (data as any).onboarding_sessions as
  | { intake_json?: Record<string, unknown> | null; type?: string | null }
  | null;
const userName =
  typeof session?.intake_json?.nombre === "string"
    ? (session!.intake_json!.nombre as string)
    : "";
const sessionTitle =
  session?.type === "deep"
    ? "Reprogramación profunda"
    : session?.type === "quick"
      ? "Alivio rápido personalizado"
      : "Tu meditación guiada";
const shareUrl = `https://vozcalma.app/p/${token}`;
const shareTitle = "Una meditación creada para ti — VozCalma";
const shareDescription =
  "Escucha esta meditación guiada personalizada. Un espacio de calma creado con intención.";
---

<!doctype html>
<html lang="es" class="h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Anti-flash dark mode -->
    <script is:inline>
      (function(){var s=localStorage.getItem('vc-theme')||'system';var d=s==='dark'||(s==='system'&&window.matchMedia('(prefers-color-scheme:dark)').matches);if(d)document.documentElement.classList.add('dark')})();
    </script>
    <title>Meditación — VozCalma</title>
    <PostHog />

    <!-- OpenGraph + Twitter Card -->
    <meta property="og:type" content="music.song" />
    <meta property="og:title" content={shareTitle} />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:url" content={shareUrl} />
    <meta property="og:image" content="https://vozcalma.app/og-share.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:audio" content={audioUrl} />
    <meta property="og:audio:type" content="audio/mpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={shareTitle} />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content="https://vozcalma.app/og-share.jpg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="m-0 p-0 w-full min-h-full font-body text-on-surface bg-soft-gradient overflow-y-auto">
    <BackgroundMusicWidget client:idle />
    <div id="app" class="w-full min-h-screen">
      <OnboardingPlayer
        audioUrl={audioUrl}
        userName={userName}
        sessionTitle={sessionTitle}
        playUrl={shareUrl}
        client:load
      />
    </div>
    <script is:inline>
      if (window.posthog && window.posthog.capture) {
        window.posthog.capture("share_link_opened");
      }
    </script>
  </body>
</html>
